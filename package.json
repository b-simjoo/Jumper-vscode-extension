{
  "name": "kangaroo",
  "displayName": "Kangaroo",
  "description": "Inline go-to-line (no dialog) with a jump-back history that survives edits.",
  "version": "0.1.1",
  "publisher": "bsimjoo",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kangaroo.start",
        "title": "Kangaroo: Go to Line (inline)"
      },
      {
        "command": "kangaroo.back",
        "title": "Kangaroo: Jump Back"
      },
      {
        "command": "kangaroo.peek",
        "title": "Kangaroo: Peek Line"
      },
      {
        "command": "kangaroo.lineEnd",
        "title": "Kangaroo: Jump Mode - End of Line"
      },
      {
        "command": "kangaroo.lineStart",
        "title": "Kangaroo: Jump Mode - Start of Line"
      },
      {
        "command": "kangaroo.acceptInsertAfter",
        "title": "Kangaroo: Accept and Insert Line Below"
      },
      {
        "command": "kangaroo.acceptInsertBefore",
        "title": "Kangaroo: Accept and Insert Line Above"
      },
      {
        "command": "kangaroo.lineUp",
        "title": "Kangaroo: Jump Mode - Previous Line"
      },
      {
        "command": "kangaroo.lineDown",
        "title": "Kangaroo: Jump Mode - Next Line"
      },
      {
        "command": "kangaroo.accept",
        "title": "Kangaroo: Accept"
      },
      {
        "command": "kangaroo.cancel",
        "title": "Kangaroo: Cancel"
      },
      {
        "command": "kangaroo.backspace",
        "title": "Kangaroo: Backspace"
      },
      {
        "command": "kangaroo.bookmark.toggle",
        "title": "Kangaroo: Toggle Bookmark on Line"
      },
      {
        "command": "kangaroo.bookmark.rename",
        "title": "Kangaroo: Rename Bookmark",
        "icon": "$(edit)"
      },
      {
        "command": "kangaroo.bookmark.delete",
        "title": "Kangaroo: Delete Bookmark",
        "icon": "$(trash)"
      },
      {
        "command": "kangaroo.bookmark.clearAll",
        "title": "Kangaroo: Delete All Bookmarks",
        "icon": "$(clear-all)"
      },
      {
        "command": "kangaroo.bookmark.open",
        "title": "Kangaroo: Open Bookmark"
      },
      {
        "command": "kangaroo.bookmarks.pick",
        "title": "Kangaroo: Search Bookmarks",
        "icon": "$(search)"
      },
      {
        "command": "kangaroo.bookmarks.pickOpenSide",
        "title": "Kangaroo: Bookmark List - Open to the Side"
      },
      {
        "command": "kangaroo.bookmarks.pickPeek",
        "title": "Kangaroo: Bookmark List - Peek"
      }
    ],
    "keybindings": [
      {
        "command": "kangaroo.start",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !kangaroo.active"
      },
      {
        "command": "kangaroo.peek",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus && !kangaroo.active"
      },
      {
        "command": "kangaroo.lineEnd",
        "key": "right",
        "when": "kangaroo.active && (editorTextFocus || referenceSearchVisible)"
      },
      {
        "command": "kangaroo.lineStart",
        "key": "left",
        "when": "kangaroo.active && (editorTextFocus || referenceSearchVisible)"
      },
      {
        "command": "kangaroo.back",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "kangaroo.backspace",
        "key": "backspace",
        "when": "kangaroo.active && (editorTextFocus || referenceSearchVisible)"
      },
      {
        "command": "kangaroo.accept",
        "key": "enter",
        "when": "kangaroo.active && (editorTextFocus || referenceSearchVisible)"
      },
      {
        "command": "kangaroo.acceptInsertAfter",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "kangaroo.active && (editorTextFocus || referenceSearchVisible)"
      },
      {
        "command": "kangaroo.acceptInsertBefore",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "kangaroo.active && (editorTextFocus || referenceSearchVisible)"
      },
      {
        "command": "kangaroo.lineUp",
        "key": "up",
        "when": "kangaroo.active && (editorTextFocus || referenceSearchVisible)"
      },
      {
        "command": "kangaroo.lineDown",
        "key": "down",
        "when": "kangaroo.active && (editorTextFocus || referenceSearchVisible)"
      },
      {
        "command": "kangaroo.cancel",
        "key": "escape",
        "when": "kangaroo.active && (editorTextFocus || referenceSearchVisible)"
      },
      {
        "command": "kangaroo.bookmark.toggle",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "kangaroo.bookmarks.pick",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j"
      },
      {
        "command": "kangaroo.bookmarks.pickOpenSide",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "inQuickOpen && kangaroo.bookmarkPicker"
      },
      {
        "command": "kangaroo.bookmarks.pickPeek",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "inQuickOpen && kangaroo.bookmarkPicker"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kangaroo",
          "title": "Kangaroo",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "kangaroo": [
        {
          "id": "kangaroo.bookmarks",
          "name": "Bookmarks"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kangaroo.bookmarks.pick",
          "when": "view == kangaroo.bookmarks",
          "group": "navigation@1"
        },
        {
          "command": "kangaroo.bookmark.clearAll",
          "when": "view == kangaroo.bookmarks",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "kangaroo.bookmark.rename",
          "when": "view == kangaroo.bookmarks && viewItem == bookmark",
          "group": "inline@1"
        },
        {
          "command": "kangaroo.bookmark.delete",
          "when": "view == kangaroo.bookmarks && viewItem == bookmark",
          "group": "inline@2"
        },
        {
          "command": "kangaroo.bookmark.rename",
          "when": "view == kangaroo.bookmarks && viewItem == bookmark",
          "group": "1_modification@1"
        },
        {
          "command": "kangaroo.bookmark.delete",
          "when": "view == kangaroo.bookmarks && viewItem == bookmark",
          "group": "1_modification@2"
        }
      ],
      "commandPalette": [
        {
          "command": "kangaroo.bookmark.open",
          "when": "false"
        },
        {
          "command": "kangaroo.bookmarks.pickOpenSide",
          "when": "false"
        },
        {
          "command": "kangaroo.bookmarks.pickPeek",
          "when": "false"
        }
      ]
    }
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "BSimjoo",
    "email": "bsimjoo@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/b-simjoo/Jumper-vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/b-simjoo/Jumper-vscode-extension/issues"
  },
  "homepage": "https://github.com/b-simjoo/Jumper-vscode-extension#readme",
  "icon": "media/icon.png"
}
